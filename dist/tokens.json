{
  "$description": "Tokens do Atlas Design System. Espelham as variáveis CSS de dist/atlas.css — para uso fora do CSS (Figma, e-mail, gráficos). Na web, prefira var(--nome).",
  "theme": {
    "dark": {
      "bg-app": "#0b0c0e",
      "bg-surface": "#141518",
      "bg-card": "#1a1b1f",
      "bg-card-hover": "#222429",
      "bg-pill": "#25272e",
      "bg-pill-hover": "#2d3038",
      "border-color": "rgba(255, 255, 255, 0.07)",
      "border-light": "rgba(255, 255, 255, 0.12)",
      "text-primary": "#ffffff",
      "text-secondary": "#9ea3b0",
      "text-muted": "#626775",
      "lime": "#44a844",
      "lime-hover": "#389338",
      "lime-bg": "rgba(68, 168, 68, 0.16)",
      "lime-border": "rgba(68, 168, 68, 0.35)"
    },
    "light": {
      "bg-app": "#f3f5f8",
      "bg-surface": "#f7f9fb",
      "bg-card": "#ffffff",
      "bg-card-hover": "#f1f4f8",
      "bg-pill": "#eef1f5",
      "bg-pill-hover": "#e3e8ef",
      "border-color": "rgba(15, 23, 42, 0.08)",
      "border-light": "rgba(15, 23, 42, 0.14)",
      "text-primary": "#0f172a",
      "text-secondary": "#4b5567",
      "text-muted": "#8a94a6",
      "lime": "#3a9a3a",
      "lime-hover": "#2f852f",
      "lime-bg": "rgba(58, 154, 58, 0.1)",
      "lime-border": "rgba(58, 154, 58, 0.32)"
    }
  },
  "brand": {
    "lime-text": "#ffffff",
    "purple-accent": "#9d7bff",
    "purple-bg": "rgba(157, 123, 255, 0.15)"
  },
  "status": {
    "success": "#34d399",
    "warning": "#fbbf24",
    "danger": "#ff5252",
    "info": "#60a5fa"
  },
  "radius": {
    "sm": "10px",
    "md": "16px",
    "lg": "24px",
    "pill": "9999px"
  },
  "font": {
    "sans": "Inter, \"Segoe UI\", Arial, Helvetica, sans-serif",
    "mono": "\"JetBrains Mono\", monospace"
  }
}
